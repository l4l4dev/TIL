---
import {href,ui,type Locale} from '@/i18n';
import './theme.css';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import ThemeProvider from '@/components/ThemeProvider.astro';
import ThemeSwitch from './ThemeSwitch.astro';
interface Props {lang:Locale; title:string; alternate:string; article?:boolean; description?:string; hasTranslation?:boolean; publishDate?:Date; tags?:string[];}
const {lang,title,alternate,article=false,description=ui[lang].description,hasTranslation=true,publishDate,tags=[]}=Astro.props;
const preview=Astro.url.pathname.includes('/theme-preview/');
const home=href(lang,preview?'theme-preview/':'');
const canonical=new URL(Astro.url.pathname,Astro.site);
const alternateUrl=new URL(alternate,Astro.site);
const siteName='l4l4dev / notes';
const ogTitle=publishDate?title:`${title} · l4l4dev`;
const ogImage=new URL(`${import.meta.env.BASE_URL.replace(/\/$/,'')}/og-default.png`,Astro.site);
const ogImageAlt='l4l4dev / notes: Today I Learned';
const defaultLangUrl=lang==='ja'?canonical:(hasTranslation?alternateUrl:undefined);
const jsonLd=publishDate&&JSON.stringify({'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,datePublished:publishDate.toISOString(),inLanguage:lang,author:{'@type':'Person',name:'l4l4dev',url:'https://l4l4dev.github.io/'},mainEntityOfPage:{'@type':'WebPage','@id':canonical.href},image:ogImage.href,keywords:tags.length?tags:undefined}).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026');
---
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>{preview && <meta name="robots" content="noindex,nofollow"/>}<meta name="description" content={description}/>{!preview && <><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" href={href(lang,'rss.xml')} title="TIL"/><link rel="alternate" hreflang={lang} href={canonical}/>{hasTranslation && <link rel="alternate" hreflang={lang==='ja'?'en':'ja'} href={alternateUrl}/>}{defaultLangUrl && <link rel="alternate" hreflang="x-default" href={defaultLangUrl}/>}<meta property="og:title" content={ogTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={publishDate?'article':'website'}/><meta property="og:site_name" content={siteName}/><meta property="og:locale" content={lang==='ja'?'ja_JP':'en_US'}/>{hasTranslation && <meta property="og:locale:alternate" content={lang==='ja'?'en_US':'ja_JP'}/>}<meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={ogImageAlt}/>{publishDate && <meta property="article:published_time" content={publishDate.toISOString()}/>}{publishDate && tags.map(tag=><meta property="article:tag" content={tag}/>)}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={ogTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><meta name="twitter:image:alt" content={ogImageAlt}/>{jsonLd && <script type="application/ld+json" set:html={jsonLd}/>}</>}<link rel="icon" href={`${import.meta.env.BASE_URL}icon.svg`} type="image/svg+xml"/><title>{title} · l4l4dev</title><ThemeProvider/><GoogleAnalytics/></head>
<body class:list={{"article-site":article}}><a class="skip" href="#main">{ui[lang].skip}</a><header class="site-header"><div class="header-inner"><a class="wordmark" href={home}>l4l4dev<span> / notes</span></a><nav aria-label={lang==='ja'?'ナビゲーション':'Navigation'}><a href={`${home}#posts`}>{ui[lang].posts}</a><a href="https://l4l4dev.github.io/">Profile ↗</a><a class="locale" href={alternate}>{lang==='ja'?'EN':'日本語'}</a><ThemeSwitch lang={lang}/></nav></div></header><main id="main" class:list={{'article-main':article}}><slot/></main><footer><span>© {new Date().getFullYear()} l4l4dev</span><div><a href="https://github.com/l4l4dev">GitHub ↗</a><a href={href(lang,'rss.xml')}>RSS</a><a href={href(lang,'about/')}>{ui[lang].about}</a></div></footer></body></html>
