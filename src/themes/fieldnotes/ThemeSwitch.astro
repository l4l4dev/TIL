---
import type {Locale} from '@/i18n';
const {lang}=Astro.props as {lang:Locale};
---
<fieldnotes-theme class="theme-switch">
<button type="button" role="switch" aria-checked="false" aria-label={lang==='ja'?'ダークモード':'Dark mode'}><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A9 9 0 0 1 8.5 4a9 9 0 1 0 11.5 11.5Z" stroke-width="1.5"/></svg><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="1.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" stroke-width="1.5" stroke-linecap="round"/></svg></button>
</fieldnotes-theme>
<script>
class FieldnotesTheme extends HTMLElement {
  connectedCallback() {
    const button=this.querySelector('button');
    if (!button) return;
    const sync=()=>{
      const dark=document.documentElement.dataset.theme==='dark';
      button.setAttribute('aria-checked',String(dark));
    };
    button.addEventListener('click',()=>document.dispatchEvent(new CustomEvent('theme-change',{detail:{theme:document.documentElement.dataset.theme==='dark'?'light':'dark'}})));
    const observer=new MutationObserver(sync);
    observer.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
    this.observer=observer;
    sync();
  }
  observer?:MutationObserver;
  disconnectedCallback(){this.observer?.disconnect();}
}
if(!customElements.get('fieldnotes-theme')) customElements.define('fieldnotes-theme',FieldnotesTheme);
</script>
