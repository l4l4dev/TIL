---
// Adapted from Pure Header: localized routes, simpler mobile navigation, reviewed theme toggle.
import {href,ui,type Locale} from '@/i18n';
import ThemeToggle from '@/components/ThemeToggle.astro';
const {lang,alternate}=Astro.props as {lang:Locale;alternate:string};
const t=ui[lang];
const links=[{url:href(lang),title:t.home},{url:href(lang,'posts/'),title:t.posts},{url:href(lang,'about/'),title:t.about}];
---
<header class="pure-header"><a class="pure-brand" href={href(lang)}>TIL<span class="text-muted font-normal text-sm ml-2">/ l4l4dev</span></a><nav aria-label={t.home}>{links.map(link=><a href={link.url} aria-current={Astro.url.pathname===link.url || (link.title===t.home && Astro.url.pathname===import.meta.env.BASE_URL)?'page':undefined}>{link.title}</a>)}</nav><div class="pure-tools"><a class="text-sm" href={alternate} lang={lang==='ja'?'en':'ja'}>{lang==='ja'?'EN':'日本語'}</a><ThemeToggle lang={lang}/></div></header>
