<script>
function enhanceCode() {
  const ja = document.documentElement.lang.startsWith('ja');
  document.querySelectorAll<HTMLPreElement>('.reading-body pre').forEach(pre => {
    if (pre.parentElement?.classList.contains('code-panel')) return;
    const raw = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
    const diff = raw.split('\n').some(line => /^[-+] /.test(line));
    const panel = document.createElement('div');
    panel.className = 'code-panel';
    pre.before(panel); panel.append(pre);
    pre.tabIndex = 0;
    pre.setAttribute('aria-label', ja ? 'コード。長い行は横にスクロールできます' : 'Code. Scroll horizontally for long lines');
    if (diff) pre.querySelectorAll<HTMLElement>('.line').forEach(line => {
      if (line.textContent?.startsWith('-')) line.classList.add('diff-remove');
      if (line.textContent?.startsWith('+')) line.classList.add('diff-add');
    });
  });
}
enhanceCode();
document.addEventListener('astro:page-load', enhanceCode);
</script>
