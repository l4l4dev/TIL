---
import Layout from '@/themes/fieldnotes/Layout.astro';
import {href,ui,type Locale} from '@/i18n';
interface Props {lang:Locale;title:string;description?:string;alternate?:string;hasTranslation?:boolean;}
const {lang,title,description=ui[lang].description,alternate=href(lang==='ja'?'en':'ja'),hasTranslation=true}=Astro.props;
---
<Layout lang={lang} title={title} description={description} alternate={alternate} hasTranslation={hasTranslation} article><div class="reading-page reading-body"><slot/></div></Layout>
