---
import {locales,ui,href,type Locale} from '@/i18n';
import Base from '@/layouts/Base.astro';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
---
<Base lang={lang} title={ui[lang].about} alternate={href(lang==='ja'?'en':'ja','about/')}><h1 class="title">{ui[lang].about}</h1><p class="mt-8 prose-copy">{ui[lang].aboutText}</p><p class="mt-6"><a class="cactus-link" href="https://github.com/l4l4dev">l4l4dev / GitHub ↗</a></p></Base>
