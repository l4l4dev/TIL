---
import {getCollection,render} from 'astro:content';
import {href,postHref,ui} from '@/i18n';
import Base from '@/layouts/Base.astro';
export async function getStaticPaths(){const posts=await getCollection('post',({data})=>!data.draft);return posts.map(post=>({params:{lang:post.data.lang,slug:post.id.split('/').slice(1).join('/')},props:{post,translation:posts.find(p=>p.data.lang!==post.data.lang&&p.data.translationKey===post.data.translationKey)}}));}
const {post,translation}=Astro.props;const lang=post.data.lang;const {Content}=await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.description} alternate={translation?postHref(translation):href(lang==='ja'?'en':'ja','posts/')} hasTranslation={!!translation}><a class="cactus-link text-muted" href={href(lang,'posts/')}>← {ui[lang].back}</a><h1 class="title mt-8 mb-4">{post.data.title}</h1><time class="text-muted text-xs" datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString(lang,{timeZone:'Asia/Tokyo'})}</time>{!translation&&<p class="mt-4 text-muted text-xs">{ui[lang].missing}</p>}<article class="prose prose-copy max-w-none mt-10" data-pagefind-body><Content/></article></Base>
