---
import {getCollection} from 'astro:content';
import {locales,href,ui,type Locale} from '@/i18n';
import Layout from '@/themes/fieldnotes/Layout.astro';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
const posts=(await getCollection('post',p=>p.data.lang===lang&&!p.data.draft)).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<Layout lang={lang} title={ui[lang].posts} alternate={href(lang==='ja'?'en':'ja','posts/')}>

<section id="posts" class="index-content"><div class="section-heading"><h2>{ui[lang].posts}</h2><span>{posts.length} {lang==='ja'?'件の記録':'notes'}</span></div><ol class="post-list">{posts.map(p=><li class="post-row"><time datetime={p.data.publishDate.toISOString()}>{p.data.publishDate.toLocaleDateString('en-CA',{timeZone:'Asia/Tokyo'})}</time><div><h3><a href={href(lang,`posts/${p.id.split('/').slice(1).join('/')}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p><div class="tags">{p.data.tags.map(t=><span>{t}</span>)}</div></div><span class="row-arrow" aria-hidden="true">↗</span></li>)}</ol></section>
</Layout>
